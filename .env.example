# =================================================================
# CLOUD DATABASE CONFIGURATION (PostgreSQL)
# =================================================================

# The hostname or IP of your PostgreSQL server
DB_HOST=app.ball-b.de

# Standard PostgreSQL port is 5432
DB_PORT=5432

# Database user authorized to update gateway_inventory
DB_USER=gateway_admin

# Database password
DB_PASSWORD=your_secure_password

# The target database name
DB_NAME=postgres

# --- ADVANCED DB OPTION ---
# You can provide a full connection string instead of individual fields above:
# DATABASE_URL=postgresql://gateway_admin:password@app.ball-b.de:5432/postgres


# =================================================================
# LOCAL WEB-APP CONFIGURATION
# =================================================================

# The port on which the local provisioner UI will run (default is 5000)
PORT=5000
HOST=0.0.0.0
FLASK_DEBUG=true
OPEN_BROWSER=true
# Runtime mode:
# - local: full local app (UI + gateway/chirpstack/milesight/webservice routes)
# - cloud_api: only cloud-safe API surface (db/auth/network), no direct gateway routes
APP_MODE=local

# Build metadata (optional but recommended for deploy/version checks)
APP_BUILD_SHA=
APP_BUILD_TAG=
APP_BUILD_TIME=


# =================================================================
# MILESIGHT GATEWAY CONFIGURATION
# =================================================================

# The local IP address of the Gateway (default is 192.168.1.1)
GATEWAY_IP=192.168.1.1

# The API username for the Gateway (default is admin)
GATEWAY_USER=admin

# The API password for the Gateway (default is password)
GATEWAY_PASSWORD=password

# Gateway auto-config (scripts/gateway_autoconfig.py)
GATEWAY_WIFI_KEY=
GATEWAY_VPN_PRIVATE_KEY=
# Cloud-Instanz: hier setzen, dann liefert die API ihn mit jedem Key aus.
# Operator-PC: leer lassen (wird aus der Cloud geholt). Gesetzt muss er zur Cloud passen.
VPN_SERVER_PUBLIC_KEY=

# =================================================================
# GATEWAY SETUP PIPELINE (scripts/gateway_setup.py, docs/GATEWAY_SETUP_KONZEPT.md)
# =================================================================
# Profil (gateway_profiles/<name>.json), passend zur freigegebenen Firmware
GATEWAY_PROFILE=ug65-60.0.0.49
# Inventar: api (Cloud-gatewayChef, keine DB-Zugangsdaten lokal) | db (direkt)
# Standard: api, wenn DB_API_PROVIDER_URL gesetzt ist und kein DB_HOST
INVENTORY_BACKEND=
# Webservice: ws1 (webservice.ball-b.de) | ws2 (neue adminapi) | off
WEBSERVICE_BACKEND=ws1
WEBSERVICE_URL=https://webservice.ball-b.de
WEBSERVICE_USER=
WEBSERVICE_PASSWORD=
WS2_URL=
WS2_READ_KEY=
WS2_WRITE_KEY=
MILESIGHT_ENABLED=true
CHIRPSTACK_ENABLED=false

# Minimum firmware version for UI warnings
RECOMMENDED_GATEWAY_FIRMWARE=60.0.0.48


# =================================================================
# CHIRPSTACK CONFIGURATION
# =================================================================

# Base URL of ChirpStack (used to build /api/gateways)
CHIRPSTACK_URL=https://chirpstack.example.com

# API token for ChirpStack (Bearer)
CHIRPSTACK_API_TOKEN=your_chirpstack_token

# Tenant ID for gateway creation
CHIRPSTACK_TENANT_ID=your_chirpstack_tenant_id

# Gateway stats interval (seconds)
CHIRPSTACK_STATS_INTERVAL_SECS=30


# =================================================================
# MILESIGHT DEVELOPER PLATFORM
# =================================================================

# Base URL for Milesight OpenAPI
MILESIGHT_URL=https://eu-openapi.milesight.com

# OAuth client id / secret
MILESIGHT_CLIENT_ID=1f506e2c-9e84-4869-a5a9-288f3bd10801
MILESIGHT_CLIENT_SECRET=your_milesight_client_secret

# Optional override for token URL (if different)
MILESIGHT_TOKEN_URL=


# =================================================================
# AUTH CONFIGURATION
# =================================================================
# Change in production.
JWT_SECRET=change-this-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRES_HOURS=24


# =================================================================
# VPN PING (optional cloud proxy)
# =================================================================
# Leave empty to ping locally from current app runtime.
# Set to your cloud API base URL when local machine cannot reach VPN.
VPN_PING_PROVIDER_URL=

# Shared token for /api/network/ping-service (set on both local caller and cloud service).
VPN_PING_SERVICE_TOKEN=

# Optional cloud DB API base URL for local runner proxy (e.g. https://<cloud-api-domain>).
# If set in local mode, /api/db*, /api/sim*, /api/provision, /api/confirm are proxied to cloud.
DB_API_PROVIDER_URL=
DB_API_TIMEOUT_SECS=10

# Service-to-service API token (optional, protects /api/db* and related DB endpoints)
API_SERVICE_TOKEN=

# VPN-POOL (scripts/pool_refill.py)
POOL_RANGES=172.30.1.1-172.30.9.254
POOL_MIN_FREE=20
POOL_BATCH=50
