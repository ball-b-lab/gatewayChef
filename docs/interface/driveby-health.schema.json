{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "gatewaychef/driveby-health",
  "title": "GET /driveby/health (Node-RED-Flow auf dem UG65, Port 1880)",
  "description": "Gilt für alle Flow-Versionen ab 1.1.0. Felder kommen nur hinzu, keins verschwindet. Unbekannte Felder ignorieren (additionalProperties: true). Fehlende optionale Felder = ältere Flow-Version. HTTP 200 = Paket-Forwarder meldet sich (stat < 65 s), 503 = nicht; der Body ist in beiden Fällen gleich aufgebaut.",
  "type": "object",
  "additionalProperties": true,
  "required": ["source", "flow_version", "counts", "app"],
  "properties": {
    "source": {"const": "udp:1702"},
    "flow_version": {"type": ["string", "null"], "description": "z. B. 1.4.0; null = Flow gestartet, Version noch nicht gesetzt"},
    "gateway_eui": {"type": ["string", "null"], "pattern": "^[0-9A-Fa-f]{16}$"},
    "seconds_since_packet": {"type": ["integer", "null"]},
    "seconds_since_stat": {"type": ["integer", "null"]},
    "seconds_since_rxpk": {"type": ["integer", "null"]},
    "counts": {"type": "object", "additionalProperties": true,
      "properties": {"push_data": {"type": "integer"}, "rxpk": {"type": "integer"}, "stat": {"type": "integer"}}},
    "app": {"type": "object", "additionalProperties": true,
      "properties": {"seconds_since_poll": {"type": ["integer", "null"]}, "last_poll": {"type": ["string", "null"]},
                     "client": {"type": ["string", "null"]}, "agent": {"type": ["string", "null"]}, "polls": {"type": "integer"}}},
    "meta": {"type": ["string", "null"]},
    "radio": {"type": "object", "additionalProperties": true, "description": "ab 1.2.0, Fenster der letzten 30 min",
      "properties": {
        "window_minutes": {"type": "integer"}, "stats": {"type": "integer"},
        "rx_total": {"type": "integer"}, "rx_ok": {"type": "integer"}, "rx_forwarded": {"type": "integer"},
        "crc_error_pct": {"type": ["number", "null"]},
        "tx_requested": {"type": "integer"}, "tx_sent": {"type": "integer"},
        "ack_pct": {"type": ["number", "null"]},
        "packets": {"type": "integer"}, "rssi_avg": {"type": ["number", "null"]}, "snr_avg": {"type": ["number", "null"]},
        "rssi_min": {"type": ["number", "null"]},
        "tx_failed": {"type": "integer", "description": "ab 1.3.0"},
        "sf": {"type": "object", "description": "ab 1.3.0, z. B. {\"SF7\": 12, \"SF9\": 3}", "additionalProperties": {"type": "integer"}}
      }},
    "devices": {"type": "array", "description": "ab 1.3.0, Sensoren der letzten 24 h (max. 500)",
      "items": {"type": "object", "additionalProperties": true,
        "properties": {"id": {"type": "string", "description": "DevAddr (kind=devaddr) oder DevEUI (kind=join), Hex groß"},
                       "kind": {"enum": ["devaddr", "join"]}, "count": {"type": "integer"}, "seconds_since": {"type": "integer"},
                       "rssi": {"type": "number"}, "snr": {"type": "number"}, "sf": {"type": ["integer", "null"]},
                       "freq": {"type": "number"}, "fcnt": {"type": ["integer", "null"]}}}}
  }
}
