[Unit]
Description=GatewayChef DHCP fuer das Gateway am Port %i
# Eingerichtete Gateways holen sich eth0 per DHCP. Nur Adressen, keine Route, kein DNS:
# das Gateway sieht nur die Station. Leases: /var/lib/gatewaychef/dhcp-lan.leases
After=network.target
Wants=network.target

[Service]
ExecStartPre=/usr/bin/install -d -m 755 /var/lib/gatewaychef
ExecStart=/usr/sbin/dnsmasq --keep-in-foreground --conf-file=/dev/null --port=0 \
  --interface=%i --bind-dynamic --except-interface=lo \
  --dhcp-range=192.168.1.100,192.168.1.150,255.255.255.0,10m \
  --dhcp-option=3 --dhcp-option=6 --dhcp-authoritative \
  --dhcp-leasefile=/var/lib/gatewaychef/dhcp-lan.leases --log-dhcp --user=root
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
